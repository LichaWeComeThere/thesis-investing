+++ b/packages/core/src/livingThesisReviewWorkflow.test.ts
@@ -0,0 +1,92 @@
+import { describe, expect, it } from 'vitest';
+import { exampleLivingThesis } from './livingThesis';
+import {
+  canCompleteLivingThesisReviewWorkflow,
+  completeLivingThesisReviewWorkflowStep,
+  getNextLivingThesisReviewWorkflowStep,
+  startLivingThesisReviewWorkflow,
+  updateLivingThesisReviewReason,
+  updateLivingThesisReviewScoreDraft
+} from './livingThesisReviewWorkflow';
+
+describe('living thesis review workflow', () => {
+  it('starts a local review workflow from a living thesis', () => {
+    const workflow = startLivingThesisReviewWorkflow(
+      exampleLivingThesis,
+      '2026-06-01T09:00:00.000Z'
+    );
+
+    expect(workflow).toMatchObject({
+      thesisId: exampleLivingThesis.id,
+      status: 'in_progress',
+      activeStep: 'start_review',
+      completedSteps: [],
+      reviewReason: '',
+      startedAt: '2026-06-01T09:00:00.000Z'
+    });
+    expect(workflow.scoreDraft).toEqual(exampleLivingThesis.mbs);
+    expect(workflow.scoreDraft).not.toBe(exampleLivingThesis.mbs);
+  });
+
+  it('tracks the ordered review steps without persistence', () => {
+    expect(getNextLivingThesisReviewWorkflowStep('start_review')).toBe(
+      'review_thesis_summary'
+    );
+    expect(getNextLivingThesisReviewWorkflowStep('complete_review')).toBe(
+      undefined
+    );
+  });
+
+  it('requires reviewed steps and a reason before completion is ready', () => {
+    let workflow = startLivingThesisReviewWorkflow(exampleLivingThesis);
+
+    for (const stepId of [
+      'start_review',
+      'review_thesis_summary',
+      'review_risks_and_catalysts',
+      'adjust_mbs_score',
+      'add_review_reason'
+    ] as const) {
+      workflow = completeLivingThesisReviewWorkflowStep(workflow, stepId);
+    }
+
+    expect(canCompleteLivingThesisReviewWorkflow(workflow)).toBe(false);
+
+    workflow = updateLivingThesisReviewReason(
+      workflow,
+      'Quarterly review after data center earnings update.'
+    );
+
+    expect(canCompleteLivingThesisReviewWorkflow(workflow)).toBe(true);
+
+    workflow = completeLivingThesisReviewWorkflowStep(
+      workflow,
+      'complete_review',
+      '2026-06-01T10:00:00.000Z'
+    );
+
+    expect(workflow.status).toBe('complete');
+    expect(workflow.completedAt).toBe('2026-06-01T10:00:00.000Z');
+  });
+
+  it('updates the local score draft immutably', () => {
+    const workflow = startLivingThesisReviewWorkflow(exampleLivingThesis);
+    const nextDraft = {
+      ...workflow.scoreDraft,
+      overallScore: 88,
+      previousScore: workflow.scoreDraft.overallScore,
+      scoreChange: 2
+    };
+
+    const updatedWorkflow = updateLivingThesisReviewScoreDraft(
+      workflow,
+      nextDraft,
+      '2026-06-01T09:30:00.000Z'
+    );
+
+    expect(updatedWorkflow.scoreDraft.overallScore).toBe(88);
+    expect(updatedWorkflow.scoreDraft).toEqual(nextDraft);
+    expect(updatedWorkflow.scoreDraft).not.toBe(nextDraft);
+    expect(updatedWorkflow.updatedAt).toBe('2026-06-01T09:30:00.000Z');
+  });
+});
