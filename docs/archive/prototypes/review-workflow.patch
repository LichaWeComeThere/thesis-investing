@@ -0,0 +1,172 @@
+import type { EntityId, IsoDateString } from './domain';
+import type { LivingThesis, LivingThesisMbsScores } from './livingThesis';
+
+export type LivingThesisReviewWorkflowStepId =
+  | 'start_review'
+  | 'review_thesis_summary'
+  | 'review_risks_and_catalysts'
+  | 'adjust_mbs_score'
+  | 'add_review_reason'
+  | 'complete_review';
+
+export type LivingThesisReviewWorkflowStatus =
+  | 'not_started'
+  | 'in_progress'
+  | 'complete';
+
+export type LivingThesisReviewWorkflowStep = {
+  id: LivingThesisReviewWorkflowStepId;
+  label: string;
+  description: string;
+};
+
+export type LivingThesisReviewWorkflow = {
+  thesisId: EntityId;
+  status: LivingThesisReviewWorkflowStatus;
+  activeStep: LivingThesisReviewWorkflowStepId;
+  completedSteps: LivingThesisReviewWorkflowStepId[];
+  reviewReason: string;
+  scoreDraft: LivingThesisMbsScores;
+  startedAt?: IsoDateString;
+  completedAt?: IsoDateString;
+  updatedAt?: IsoDateString;
+};
+
+export const LIVING_THESIS_REVIEW_WORKFLOW_STEPS: LivingThesisReviewWorkflowStep[] =
+  [
+    {
+      id: 'start_review',
+      label: 'Start review',
+      description: 'Begin a local review session for the selected thesis.'
+    },
+    {
+      id: 'review_thesis_summary',
+      label: 'Review thesis summary',
+      description: 'Re-read the core thesis and current investment logic.'
+    },
+    {
+      id: 'review_risks_and_catalysts',
+      label: 'Review risks and catalysts',
+      description: 'Check whether risks, catalysts, and triggers changed.'
+    },
+    {
+      id: 'adjust_mbs_score',
+      label: 'Adjust MBS score',
+      description: 'Update local score assumptions before saving later.'
+    },
+    {
+      id: 'add_review_reason',
+      label: 'Add review reason',
+      description: 'Capture why this thesis was reviewed.'
+    },
+    {
+      id: 'complete_review',
+      label: 'Complete review',
+      description: 'Mark the local review workflow complete.'
+    }
+  ];
+
+export function startLivingThesisReviewWorkflow(
+  thesis: LivingThesis,
+  startedAt?: IsoDateString
+): LivingThesisReviewWorkflow {
+  return {
+    thesisId: thesis.id,
+    status: 'in_progress',
+    activeStep: 'start_review',
+    completedSteps: [],
+    reviewReason: '',
+    scoreDraft: { ...thesis.mbs },
+    startedAt,
+    updatedAt: startedAt
+  };
+}
+
+export function updateLivingThesisReviewReason(
+  workflow: LivingThesisReviewWorkflow,
+  reviewReason: string,
+  updatedAt?: IsoDateString
+): LivingThesisReviewWorkflow {
+  return {
+    ...workflow,
+    reviewReason,
+    updatedAt: updatedAt ?? workflow.updatedAt
+  };
+}
+
+export function updateLivingThesisReviewScoreDraft(
+  workflow: LivingThesisReviewWorkflow,
+  scoreDraft: LivingThesisMbsScores,
+  updatedAt?: IsoDateString
+): LivingThesisReviewWorkflow {
+  return {
+    ...workflow,
+    scoreDraft: { ...scoreDraft },
+    updatedAt: updatedAt ?? workflow.updatedAt
+  };
+}
+
+export function completeLivingThesisReviewWorkflowStep(
+  workflow: LivingThesisReviewWorkflow,
+  stepId: LivingThesisReviewWorkflowStepId,
+  updatedAt?: IsoDateString
+): LivingThesisReviewWorkflow {
+  const completedSteps = addCompletedWorkflowStep(
+    workflow.completedSteps,
+    stepId
+  );
+  const nextStep = getNextLivingThesisReviewWorkflowStep(stepId);
+
+  if (stepId === 'complete_review') {
+    return {
+      ...workflow,
+      status: 'complete',
+      activeStep: 'complete_review',
+      completedSteps,
+      completedAt: updatedAt,
+      updatedAt: updatedAt ?? workflow.updatedAt
+    };
+  }
+
+  return {
+    ...workflow,
+    status: 'in_progress',
+    activeStep: nextStep ?? stepId,
+    completedSteps,
+    updatedAt: updatedAt ?? workflow.updatedAt
+  };
+}
+
+export function canCompleteLivingThesisReviewWorkflow(
+  workflow: LivingThesisReviewWorkflow
+): boolean {
+  const requiredSteps = LIVING_THESIS_REVIEW_WORKFLOW_STEPS.filter(
+    (step) => step.id !== 'complete_review'
+  ).map((step) => step.id);
+
+  return (
+    workflow.reviewReason.trim().length > 0 &&
+    requiredSteps.every((stepId) => workflow.completedSteps.includes(stepId))
+  );
+}
+
+export function getNextLivingThesisReviewWorkflowStep(
+  stepId: LivingThesisReviewWorkflowStepId
+): LivingThesisReviewWorkflowStepId | undefined {
+  const stepIndex = LIVING_THESIS_REVIEW_WORKFLOW_STEPS.findIndex(
+    (step) => step.id === stepId
+  );
+
+  return LIVING_THESIS_REVIEW_WORKFLOW_STEPS[stepIndex + 1]?.id;
+}
+
+function addCompletedWorkflowStep(
+  completedSteps: LivingThesisReviewWorkflowStepId[],
+  stepId: LivingThesisReviewWorkflowStepId
+): LivingThesisReviewWorkflowStepId[] {
+  if (completedSteps.includes(stepId)) {
+    return completedSteps;
+  }
+
+  return [...completedSteps, stepId];
+}
