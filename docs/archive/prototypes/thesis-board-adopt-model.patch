+export function mockThesisToLivingThesis(thesis: MockThesis): LivingThesis {
+  const categoryScore = thesis.mbsScore / 10;
+  const scoreChange = thesis.mbsScore - thesis.previousMbsScore;
+  const createdAt =
+    thesis.decisionLog[0]?.createdAt ??
+    `${thesis.lastReviewedDate}T09:00:00.000Z`;
+
+  return {
+    id: thesis.id,
+    ticker: thesis.ticker,
+    companyName: thesis.companyName,
+    sector: getMockThesisSector(thesis),
+    theme: thesis.theme,
+    thesisTitle: `${thesis.companyName} ${thesis.theme} thesis`,
+    thesisSummary: thesis.thesisSummary,
+    bullCase: thesis.bullCase,
+    bearCase: thesis.bearCase,
+    keyRisks: thesis.keyRisks,
+    catalysts: thesis.catalysts,
+    notes: thesis.reviewTriggers.join(', '),
+    mbs: {
+      balanceSheet: categoryScore,
+      businessQuality: categoryScore,
+      growth: categoryScore,
+      management: categoryScore,
+      moat: categoryScore,
