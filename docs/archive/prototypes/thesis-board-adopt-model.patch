+
+function mapMockConvictionToLivingThesis(
+  conviction: MockThesisConviction
+): LivingThesis['conviction'] {
+  return conviction.toLowerCase() as LivingThesis['conviction'];
+}
+
+function mapMockStatusToLivingThesisHealth(
+  status: MockThesisStatus
+): LivingThesisHealth {
+  if (status === 'Improving') {
+    return 'improving';
+  }
+
+  if (status === 'Weakening') {
+    return 'weakening';
+  }
+
+  if (status === 'Broken') {
+    return 'needs_review';
+  }
+
+  return 'stable';
+}
+
+function mapMockIdeaStatusToLivingThesisStage(
+  status: MockThesisIdeaStatus
+): LivingThesisStage {
+  if (status === 'Archived') {
+    return 'archived';
+  }
+
+  if (status === 'Watchlist' || status === 'Researching') {
+    return 'watching';
+  }
+
+  return 'active';
+}
+
+function mapMockIdeaStatusToLivingThesisReviewStatus(
+  status: MockThesisIdeaStatus
+): LivingThesisReviewStatus {
+  if (status === 'Needs Review' || status === 'Caution') {
+    return 'overdue';
+  }
+
+  if (status === 'Researching') {
+    return 'due_soon';
+  }
+
+  return 'current';
+}
+
+function getMockThesisSector(thesis: MockThesis): string {
+  if (thesis.theme.includes('Finance')) {
+    return 'Financials';
+  }
+
+  if (thesis.theme.includes('Energy')) {
+    return 'Consumer Discretionary';
+  }
+
+  return 'Technology';
+}
