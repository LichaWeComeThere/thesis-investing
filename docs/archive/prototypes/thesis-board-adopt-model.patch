+    ),
+    nextReviewDate: thesis.nextReviewDate,
+    lastReviewedDate: thesis.lastReviewedDate,
+    decisionLog: thesis.decisionLog.map((entry) => ({
+      id: entry.id,
+      decision: entry.title,
+      note: entry.note,
+      createdAt: entry.createdAt
+    })),
+    scoreHistory: [
+      {
+        id: `score-${thesis.id}`,
+        score: thesis.mbsScore,
+        previousScore: thesis.previousMbsScore,
+        scoreChange,
+        recordedAt: `${thesis.lastReviewedDate}T09:00:00.000Z`,
+        note: 'Mock thesis MBS score snapshot.'
+      }
+    ],
+    reviewHistory: [
+      {
+        id: `review-${thesis.id}`,
+        reviewedAt: `${thesis.lastReviewedDate}T09:00:00.000Z`,
+        reviewStatus: mapMockIdeaStatusToLivingThesisReviewStatus(
+          thesis.ideaStatus
