{
  "name": "@thesis-investing/desktop",
  "version": "0.9.0",
  "description": "Windows-first offline investing discipline desktop app.",
  "author": "Manuel Diaz",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "package:windows": "electron-vite build && electron-builder --win dir --config electron-builder.yml --publish never",
    "verify:storage": "electron-vite build && electron ./out/main/verifyStorageRuntime.js",
    "verify:desktop": "electron-vite build && node ./scripts/verifyDesktopRuntime.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@thesis-investing/core": "workspace:*",
    "@thesis-investing/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.4.5",
    "electron-builder": "26.0.12",
    "electron-vite": "^2.3.0",
    "jsdom": "26.1.0",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  },
  "license": "MIT"
}
